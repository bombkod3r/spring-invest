PORT=5000

DATABASE_URL=postgresql://username:password@localhost:5432/springs_invests

JWT_SECRET=change_this_to_a_long_random_secret

FRONTEND_URL=http://localhost:3000

# Optional individual database settings when DATABASE_URL is not set
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=springs_invests
# DB_USER=postgres
# DB_PASSWORD=change_this_password

# Set to production on the deployment host to enable PostgreSQL SSL
# NODE_ENV=production

# Used only by `npm run admin:create`; never commit these values.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-unique-password
